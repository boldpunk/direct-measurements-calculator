generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Singleton row (id always "default") holding company settings + order numbering.
model Settings {
  id              String @id @default("default")
  companyName     String @default("Sobirov Mebel")
  currency        String @default("$")
  stageBufferDays Int    @default(3)
  orderSeq        Int    @default(100)
}

model Employee {
  id           String   @id
  name         String
  role         String
  phone        String   @default("")
  email        String?  @unique
  passwordHash String?
  createdAt    Float    @default(0)

  // RBAC
  accessRole       String   @default("Индивидуальная")
  permissions       Json    @default("{}")
  financialFlags    Json    @default("{}")
  scopeFlags        Json    @default("{}")
  isBlocked         Boolean @default(false)
  failedLoginCount  Int     @default(0)
  lockedUntil       Float?
  lastActivityAt    Float?

  managedOrders   Order[]  @relation("OrderManager")
  assignedStages  Stage[]  @relation("StageAssignee")
  assignedTasks   Task[]   @relation("TaskAssignee")
  reworkResponsible Rework[] @relation("ReworkResponsible")
  auditLogs         AuditLog[]
  stockMovements    StockMovement[]
}

model AuditLog {
  id         String   @id
  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  employeeName String  @default("")
  timestamp  Float
  action     String
  entityType String
  entityId   String?
  oldValue   Json?
  newValue   Json?
  ip         String   @default("")
  userAgent  String   @default("")

  @@index([timestamp])
  @@index([employeeId])
}

model Partner {
  id          String   @id
  name        String
  services    String[]
  contacts    String   @default("")
  avgLeadDays Int      @default(0)
  rating      Int      @default(0)
  comment     String   @default("")

  stages Stage[]
}

model Client {
  id        String   @id
  name      String
  phone     String   @default("")
  address   String   @default("")
  createdAt Float    @default(0)

  orders Order[]
}

model Order {
  id            String   @id
  number        Int      @unique
  clientId      String?
  client        Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientName    String   @default("")
  clientPhone   String   @default("")
  address       String   @default("")
  productType   String
  managerId     String?
  manager       Employee? @relation("OrderManager", fields: [managerId], references: [id], onDelete: SetNull)
  amount        Float    @default(0)
  startDate     String
  deadline      String
  status        String
  needsCarpentry Boolean @default(true)
  notes         String   @default("")
  createdAt     Float    @default(0)

  stages         Stage[]
  tasks          Task[]
  rework         Rework[]
  activity       Activity[]
  payments       Payment[]
  materials      Material[]
  outsourcing    OutsourceExpense[]
  salaries       SalaryExpense[]
  otherExpenses  OtherExpense[]
}

model Activity {
  id        String @id
  orderId   String
  order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  timestamp Float
  text      String

  @@index([orderId])
}

model Stage {
  id         String   @id
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  defKey     String
  name       String
  type       String
  service    String?
  position   Int
  assigneeId String?
  assignee   Employee? @relation("StageAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  partnerId  String?
  partner    Partner?  @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  deadline   String
  status     String
  skipped    Boolean  @default(false)

  tasks Task[]

  @@index([orderId])
}

model Task {
  id         String   @id
  orderId    String?
  order      Order?   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  stageId    String?
  stage      Stage?   @relation(fields: [stageId], references: [id], onDelete: SetNull)
  stageKey   String?
  name       String
  qty        Int      @default(1)
  assigneeId String?
  assignee   Employee? @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  deadline   String
  status     String
  priority   String
  comment    String   @default("")
  createdAt  Float    @default(0)

  rework Rework?

  @@index([orderId])
}

model Rework {
  id            String   @id
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reason        String
  description   String
  photoUrl      String   @default("")
  responsibleId String?
  responsible   Employee? @relation("ReworkResponsible", fields: [responsibleId], references: [id], onDelete: SetNull)
  urgency       String
  status        String
  costImpact    Float    @default(0)
  taskId        String?  @unique
  task          Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  createdAt     Float    @default(0)

  @@index([orderId])
}

model Payment {
  id      String @id
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  date    String
  comment String @default("")
  amount  Float  @default(0)

  @@index([orderId])
}

model Material {
  id        String @id
  orderId   String
  order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  name      String
  qty       Float  @default(0)
  unit      String @default("шт.")
  unitPrice Float  @default(0)

  // Set when this line was pulled from the Склад catalog rather than typed
  // manually — drives the reservation lifecycle (see StockReservation).
  specId String?
  spec   ProductSpec? @relation(fields: [specId], references: [id], onDelete: SetNull)
  source String       @default("manual") // 'manual' | 'stock'

  reservation StockReservation?

  @@index([orderId])
}

// ---- Склад (warehouse) ----

model Category {
  id        String @id
  name      String @unique
  createdAt Float  @default(0)

  products Product[]
}

model Brand {
  id        String @id
  name      String @unique
  createdAt Float  @default(0)

  products Product[]
}

model Supplier {
  id            String @id
  name          String
  phone         String @default("")
  contactPerson String @default("")
  comment       String @default("")
  createdAt     Float  @default(0)

  specs     ProductSpec[]
  movements StockMovement[]
  payments  SupplierPayment[]
}

model SupplierPayment {
  id         String   @id
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  date       String
  amount     Float    @default(0)
  comment    String   @default("")
  employeeId String?
  createdAt  Float

  @@index([supplierId])
}

// "Наименование" — a product name under a category+brand (e.g. "Clip Top").
// Stock itself is tracked one level down, per specification (ProductSpec),
// since a hinge's "горбатая" and "прямая" variants are separate stock units.
model Product {
  id         String   @id
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  brandId    String
  brand      Brand    @relation(fields: [brandId], references: [id])
  name       String
  createdAt  Float    @default(0)

  specs ProductSpec[]

  @@index([categoryId])
  @@index([brandId])
}

// The actual stock-keeping unit: Category -> Brand -> Product -> Specification.
// name may be empty ("—") for products with no meaningful variant.
model ProductSpec {
  id            String    @id
  productId     String
  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  name          String    @default("")
  sku           String    @default("")
  unit          String    @default("шт.")
  qty           Float     @default(0)
  reserved      Float     @default(0)
  minStock      Float?
  purchasePrice Float     @default(0)
  salePrice     Float     @default(0)
  supplierId    String?
  supplier      Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  location      String    @default("")
  comment       String    @default("")
  status        String    @default("active") // 'active' | 'archived'
  createdAt     Float     @default(0)

  movements    StockMovement[]
  reservations StockReservation[]
  materials    Material[]

  @@index([productId])
}

model StockMovement {
  id         String       @id
  specId     String
  spec       ProductSpec  @relation(fields: [specId], references: [id], onDelete: Cascade)
  type       String       // income | expense | reserve | unreserve | adjustment | return
  qty        Float
  price      Float?
  supplierId String?
  supplier   Supplier?    @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  employeeId String?
  employee   Employee?    @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  orderId    String?
  reason     String       @default("")
  comment    String       @default("")
  createdAt  Float

  @@index([specId])
  @@index([orderId])
}

// One row per active reservation, 1:1 with the order Material line that
// created it. Deleted (not soft-deleted) once released or written off —
// that release/write-off is itself recorded as a StockMovement, so history
// survives independently of this table.
model StockReservation {
  id         String      @id
  specId     String
  spec       ProductSpec @relation(fields: [specId], references: [id], onDelete: Cascade)
  orderId    String
  materialId String      @unique
  material   Material    @relation(fields: [materialId], references: [id], onDelete: Cascade)
  qty        Float
  createdAt  Float

  @@index([specId])
  @@index([orderId])
}

model OutsourceExpense {
  id      String @id
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  name    String
  amount  Float  @default(0)

  @@index([orderId])
}

model SalaryExpense {
  id      String @id
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  name    String
  amount  Float  @default(0)

  @@index([orderId])
}

model OtherExpense {
  id      String @id
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  name    String
  amount  Float  @default(0)

  @@index([orderId])
}
